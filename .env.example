# PeaceAi server configuration
PORT=3000
HOST=0.0.0.0

# Secret used to encrypt stored provider API keys and sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PEACEAI_SECRET=change-me-to-a-long-random-hex-string

# Where persistent JSON data and tenant sandboxes live (relative to project root).
PEACEAI_DATA_DIR=./data

# Session lifetime in hours
SESSION_HOURS=168
