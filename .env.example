# PeaceAi server configuration
PORT=3000
HOST=0.0.0.0

# Secret used to encrypt stored provider API keys and sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PEACEAI_SECRET=change-me-to-a-long-random-hex-string

# Where the SQLite database and tenant sandboxes live (relative to project root).
# Existing data/db.json files are imported automatically on first start.
PEACEAI_DATA_DIR=./data

# Command isolation for coding tools: auto (use bubblewrap when installed),
# bwrap (require it), or none (path/command allowlists only).
PEACEAI_SANDBOX=auto
# PEACEAI_TOOL_TIMEOUT_MS=10000
# PEACEAI_TOOL_MAX_OUTPUT=100000

# Session lifetime in hours
SESSION_HOURS=168

# Cookie security: "auto" (default) uses Secure only on HTTPS connections.
# Set to false explicitly only for local HTTP development behind no proxy.
# COOKIE_SECURE=auto

# Optional per-workspace limits can be set from the admin API
# (PUT /api/admin/limits) — monthlyTokens and monthlyCost.
